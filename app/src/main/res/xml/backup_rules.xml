<?xml version="1.0" encoding="utf-8"?><!--
    Auto Backup rules for API 24-30.
    The encrypted prefs keyset is bound to a non-backed-up Android Keystore key, and the
    Room DB is only a server-side cache — restoring either onto another device crash-loops
    the app, so both are excluded from backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="helpdesk_secure_prefs.xml" />
    <exclude domain="database" path="helpdesk.db" />
    <exclude domain="database" path="helpdesk.db-wal" />
    <exclude domain="database" path="helpdesk.db-shm" />
    <exclude domain="database" path="helpdesk.db-journal" />
</full-backup-content>
