<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Sync interval -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Интервал синхронизации"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerSyncInterval"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#2A2A2A"
                android:popupBackground="#1E1E1E"/>

            <!-- Sort order -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сортировка заявок"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerSortOrder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#2A2A2A"
                android:popupBackground="#1E1E1E"/>

            <!-- Server URL -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Адрес сервера"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:hint="https://example.com">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServerUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:background="@null"
                    android:inputType="textUri"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Closed connections retention -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Показывать закрытые/отклонённые подключения"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"/>

            <Spinner
                android:id="@+id/spinnerClosedConnRetention"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#2A2A2A"
                android:popupBackground="#1E1E1E"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Сохранить"
                android:backgroundTint="#1D4ED8"
                android:textColor="#FFFFFF"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginVertical="20dp"/>

            <!-- Cache management -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Данные"
                android:textColor="#BBBBBB"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCache"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Очистить кеш заявок"
                android:textColor="#F59E0B"
                app:strokeColor="#F59E0B"
                app:strokeWidth="1dp"
                xmlns:app="http://schemas.android.com/apk/res-auto"/>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginVertical="20dp"/>

            <!-- Crash log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Журнал ошибок"
                    android:textColor="#BBBBBB"
                    android:textSize="12sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyCrashLog"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Скопировать"
                    android:textColor="#42A5F5"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCrashLog"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Очистить"
                    android:textColor="#CF6679"/>
            </LinearLayout>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="#1A1A1A">

                <TextView
                    android:id="@+id/tvCrashLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textSize="11sp"
                    android:textColor="#AAAAAA"
                    android:fontFamily="monospace"
                    android:text="Ошибок нет"/>
            </androidx.core.widget.NestedScrollView>

            <!-- Version info -->
            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textSize="12sp"
                android:textColor="#555555"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
