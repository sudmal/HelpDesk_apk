<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#2A2A2A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <View
            android:id="@+id/viewStatusStrip"
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="#6B7280"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Row 1: name + status badge + call button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvNew"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="#F97316"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:background="@drawable/bg_status"
                    android:layout_marginEnd="6dp"/>

                <ImageButton
                    android:id="@+id/btnCall"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_call"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Позвонить"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Row 1b: secondary badges (act changes, feasibility) -->
            <LinearLayout
                android:id="@+id/layoutBadges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvActBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="есть правки акта"
                    android:textSize="10sp"
                    android:textColor="#000000"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="#FBBF24"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvFeasibilityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="нужен ответ монтажника"
                    android:textSize="10sp"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:background="#8B5CF6"
                    android:layout_marginEnd="6dp"
                    android:visibility="gone"/>

            </LinearLayout>

            <!-- Row 2: address -->
            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="#E0E0E0"
                android:layout_marginTop="4dp"/>

            <!-- Row 3: territory + date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvTerritory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"/>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#9E9E9E"/>

            </LinearLayout>

            <!-- Row 4: description preview -->
            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#F59E0B"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp"
                android:visibility="gone"/>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
