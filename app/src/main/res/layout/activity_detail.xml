<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvServiceTypeDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_status"
                android:visibility="gone"/>

            <TextView android:id="@+id/tvType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:textColor="#CCCCCC"/>

            <TextView android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="#CCCCCC"/>

            <TextView android:id="@+id/tvPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="#CCCCCC"/>

            <TextView android:id="@+id/tvTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="#CCCCCC"/>

            <TextView android:id="@+id/tvBrigade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="#CCCCCC"/>

            <TextView android:id="@+id/tvAssignee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="#CCCCCC"/>

            <TextView android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="14sp"
                android:textColor="#F59E0B"/>

            <!-- Блок акта — виден, если у заявки есть акт, независимо от статуса заявки
                 (акт переживает переоткрытие заявки, POST /tickets/{id}/reopen) -->
            <LinearLayout
                android:id="@+id/blockAct"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0D2B1D"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvActNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#4ADE80"/>

                <TextView
                    android:id="@+id/tvPromotionBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FBBF24"
                    android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenAct"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Открыть акт"
                    android:textColor="#4ADE80"
                    app:strokeColor="#4ADE80"
                    app:strokeWidth="1dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Блок закрытия — виден только для финальных заявок -->
            <LinearLayout
                android:id="@+id/blockClosed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#0D2B1D"
                android:padding="12dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvClosedAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4ADE80"/>

                <TextView
                    android:id="@+id/tvCloseNotesLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Итог закрытия"
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvClosedByAt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvCloseNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#D1D5DB"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Вложения заявки -->
            <LinearLayout
                android:id="@+id/blockAttachments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Фото"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerAttachments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginVertical="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Комментарии"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#FFFFFF"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Панель комментария — видна для заявок в любом статусе -->
    <LinearLayout
        android:id="@+id/panelComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#1E1E1E"
        android:elevation="4dp">

        <!-- Превью выбранного фото для комментария -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCommentPhotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:visibility="gone"/>

        <!-- Строка комментария -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Комментарий"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="#888888"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxStrokeErrorColor="#CF6679"
                app:boxBackgroundColor="#2A2A2A"
                app:hintTextColor="#9E9E9E">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#757575"
                    android:background="@null"
                    android:maxLines="3"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnAttachPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📎"
                android:layout_marginStart="4dp"
                android:layout_gravity="bottom"
                android:backgroundTint="#37474F"/>

            <Button
                android:id="@+id/btnSendComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:layout_marginStart="4dp"
                android:layout_gravity="bottom"
                android:backgroundTint="#1565C0"/>
        </LinearLayout>

        <!-- Строка кнопок действий -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReschedule"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Перенести"
                android:textColor="#42A5F5"
                app:strokeColor="#42A5F5"
                app:strokeWidth="1dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseTicket"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Закрыть заявку"
                android:backgroundTint="#10B981"
                android:textColor="#FFFFFF"/>

        </LinearLayout>

        <!-- Кнопка переоткрытия — видна только для финальной заявки при ticket.can.reopen -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReopenTicket"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="↻ Переоткрыть заявку"
            android:textColor="#42A5F5"
            app:strokeColor="#42A5F5"
            app:strokeWidth="1dp"
            android:visibility="gone"/>

        <!-- Кнопка отмены — видна только бригадиру, пока заявка не в финальном статусе -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelTicket"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="✕ Отменить заявку"
            android:textColor="#EF4444"
            app:strokeColor="#EF4444"
            app:strokeWidth="1dp"
            android:visibility="gone"/>
    </LinearLayout>
</LinearLayout>
